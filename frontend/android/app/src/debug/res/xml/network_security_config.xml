<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-ONLY network security config.
    Permits cleartext HTTP to LAN / private IP ranges so the Flutter app
    can reach the FastAPI backend on the developer's machine during testing.
    This file is in src/debug/ and is NOT included in release builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- LAN 192.168.x.x -->
        <domain includeSubdomains="false">192.168.250.217</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator host alias -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
